# ── Options Positioning module (Massive.com) ────────────────────────────────
# API key for api.massive.com. Set the real value in Render's environment
# settings — never commit it.
MASSIVE_API_KEY=your-massive-api-key-here

# Daily snapshot time (UTC, HH:MM). Default 19:30 ≈ 22:30 Riga in summer.
# OPTIONS_SNAPSHOT_UTC=19:30

# Set to "off" to disable the in-process daily snapshot scheduler.
# OPTIONS_SCHEDULER=on

# ── Existing dashboard ──────────────────────────────────────────────────────
FRED_API_KEY=your-fred-api-key-here

# COT module: Postgres URL (optional; falls back to SQLite on the disk).
# DATABASE_URL=postgresql://...

# COT module: webhook for failure alerts (optional).
# COT_ALERT_WEBHOOK=
